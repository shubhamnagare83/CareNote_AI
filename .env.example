# ── Google Gemini (clinical extraction, SOAP notes, RAG answers) ──────────
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional. Gemini retires model names periodically, and every call site here
# falls back to the local rule-based engine on error — so a retired model name
# fails silently rather than loudly. Override if the default stops resolving.
# Defaults to gemini-3.6-flash.
GEMINI_MODEL=

# ── HuggingFace (pyannote neural diarization for uploaded audio files) ────
# Requires accepting the terms for pyannote/speaker-diarization-3.1 and
# pyannote/segmentation-3.0. Not needed for live streaming, which uses the
# built-in online diarizer.
HF_TOKEN=

# ── Realtime tuning (all optional) ────────────────────────────────────────
# Whisper tier used for committed transcript text (default: base on CPU,
# large-v3 on CUDA).
WHISPER_FINAL_MODEL=
# Whisper tier used for throwaway interim text while someone is still
# speaking (default: tiny on CPU, small on CUDA).
WHISPER_PARTIAL_MODEL=
# Set to 0 to skip warming model weights at startup.
PRELOAD_MODELS=
